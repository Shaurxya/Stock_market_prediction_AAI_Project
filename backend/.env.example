# Backend Environment Variables
# Copy this file to .env and update values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model Configuration
# Optional absolute path for model cache; defaults to models/saved_models in the repo.
# MODEL_DIR=/absolute/path/to/model-cache
# Optional completed analytics snapshots; defaults to artifacts/analytics in the repo.
# ANALYTICS_ARTIFACTS_DIR=/absolute/path/to/artifacts/analytics
DEFAULT_TICKER=AAPL
DEFAULT_PERIOD=2y

# Optional: API Keys for future features
# ALPHA_VANTAGE_KEY=your_key_here
# NEWS_API_KEY=your_key_here
