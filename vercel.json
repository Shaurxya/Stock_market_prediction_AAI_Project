{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{analytics/**,datasets/**,artifacts/**,backend/venv/**,backend/tests/**,frontend/**,**/__pycache__/**,models/plots/**}"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
